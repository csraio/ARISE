#!/bin/sh
# ARISE pre-commit gate: format check on staged C++ files, then build + run all tests.
# Enable once per clone:  git config core.hooksPath .githooks
#
# The gate checks exactly what is being committed. Staged files (the index) are
# exported to a snapshot under .git/arise-gate/, so unstaged edits and untracked
# files can neither break nor rescue a commit. The snapshot and its build directory
# persist between commits, and only changed files are rewritten, so builds stay
# incremental.
set -eu

if ! command -v rsync >/dev/null 2>&1; then
    echo "pre-commit: rsync is required to snapshot the index." >&2
    exit 1
fi

gate_dir="$(git rev-parse --absolute-git-dir)/arise-gate"
snapshot="$gate_dir/src"
export_dir=$(mktemp -d "${TMPDIR:-/tmp}/arise-index.XXXXXX")
cleanup() {
    rm -rf "$export_dir"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# Staged C++ files, listed before leaving the work tree (git commands do not work
# from inside .git). Two steps so a git failure stops the hook instead of being
# masked by `|| true`.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
staged_cpp=$(echo "$staged" | grep -E '\.(cpp|hpp|h|cc)$' || true)

# 0. Snapshot the index. --checksum without -t leaves unchanged files (and their
#    timestamps) alone; build/ is excluded so the cached build survives --delete.
git checkout-index --all --prefix="$export_dir/"
mkdir -p "$snapshot"
rsync -r -l -p --checksum --delete --exclude=/build/ "$export_dir/" "$snapshot/"

# git runs hooks with repo-local variables such as GIT_INDEX_FILE set. Any git the
# build starts (FetchContent cloning GoogleTest) would inherit them and act on this
# repository instead of its own clone. The index is exported, so drop them all.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

echo "pre-commit: testing the staged snapshot in $snapshot"
cd "$snapshot"

# 1. Formatting (staged C++ files only, as staged)
if [ -n "$staged_cpp" ]; then
    if command -v clang-format >/dev/null 2>&1; then
        echo "pre-commit: checking formatting..."
        # shellcheck disable=SC2086
        clang-format --dry-run --Werror $staged_cpp
    else
        echo "pre-commit: WARNING clang-format not installed; skipping format check." >&2
    fi
fi

# 2. Build + tests
if [ ! -f CMakeLists.txt ]; then
    echo "pre-commit: no CMakeLists.txt yet; skipping build and tests."
    exit 0
fi

echo "pre-commit: configuring, building and running tests..."
cmake --preset dev
cmake --build --preset dev
ctest --preset dev --output-on-failure
echo "pre-commit: all tests passed."
