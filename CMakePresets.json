{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug (native)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer/UBSan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      }
    },
    {
      "name": "release",
      "displayName": "Release (native)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm",
      "displayName": "Debug WebAssembly (Emscripten) with runtime checks; source emsdk_env.sh first",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CROSSCOMPILING_EMULATOR": "$env{EMSDK_NODE}",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined -sASSERTIONS=2 -sSAFE_HEAP=1 -sSTACK_OVERFLOW_CHECK=2 -sALLOW_MEMORY_GROWTH=1"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "Release WebAssembly (Emscripten) for timing arise_bench under Node; source emsdk_env.sh first",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CROSSCOMPILING_EMULATOR": "$env{EMSDK_NODE}",
        "CMAKE_EXE_LINKER_FLAGS": "-sALLOW_MEMORY_GROWTH=1"
      }
    },
    {
      "name": "web",
      "displayName": "Release WebAssembly engine for the web client (apps/wasm, no tests); source emsdk_env.sh first",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ARISE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "wasm", "configurePreset": "wasm" },
    { "name": "wasm-release", "configurePreset": "wasm-release", "targets": ["arise_bench"] },
    { "name": "web", "configurePreset": "web", "targets": ["arise_engine", "arise_site"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "skip-heavy",
      "hidden": true,
      "filter": {
        "exclude": {
          "name": "^(BenchmarkReference\\.|GroupProtonHoldout\\.|PipelineReference\\.|Provenance\\.GroupProtonShiftsAreRecomputedFromTheExtract$|Provenance\\.GroupProtonShiftsMatchRdkitsMeasurement$|CarbonFitReference\\.|GroupSuggestionHoldout\\.|Reference\\.AlwaysSplitCarbonsAreSeparatePeaksWhereNmrshiftdb2ListsBoth$|Provenance\\.GroupShiftsAreRecomputedFromTheExtract$|Provenance\\.HybridizationShiftsAreRecomputedFromTheExtract$|Reference\\.KeyAtomsMatchRdkitFragmentPatterns$|Reference\\.EveryOccurrenceHasItsHallmarksOnCarbon$)"
        }
      }
    },
    {
      "name": "asan",
      "inherits": "skip-heavy",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "gate-selftest",
      "inherits": "skip-heavy",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "wasm",
      "configurePreset": "wasm",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
